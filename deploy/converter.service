[Unit]
Description=Converter web app (FastAPI)
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/converter
ExecStart=/var/www/converter/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001 --proxy-headers
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=3

# Keep the converter from starving nginx and the portfolio of memory.
MemoryHigh=500M
MemoryMax=650M

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
